<ui:UiPage x:Class="Dotstrap.UI.Elements.Settings.Pages.OptimizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Dotstrap.Resources"
      xmlns:controls="clr-namespace:Dotstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Dotstrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance Type=models:OptimizationViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="1200" d:DesignWidth="800"
      Title="OptimizationPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" Text="{x:Static resources:Strings.Menu_Optimization_Description}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Margin="0,0,0,8" Text="{x:Static resources:Strings.Menu_Optimization_ManagerDisabled}" TextWrapping="Wrap" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding FastFlagManagerDisabledVisibility, Mode=OneTime}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Profiles_Title}" FontSize="20" FontWeight="Medium" Margin="0,8,0,0" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_Profiles_MaxPerformance}"
            Description="{x:Static resources:Strings.Menu_Optimization_Profiles_MaxPerformance_Description}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="Rocket24" Appearance="Primary" Content="{x:Static resources:Strings.Menu_Optimization_Profiles_Apply}" Command="{Binding ApplyMaxPerformanceCommand}" />
                <ui:Button Margin="8,0,0,0" Icon="ArrowReset24" Content="{x:Static resources:Strings.Menu_Optimization_Profiles_Reset}" Command="{Binding ResetOptimizationCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_Graphics}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_QualityLevel_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_QualityLevel_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding QualityLevels.Keys, Mode=OneTime}" Text="{Binding SelectedQualityLevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_PauseVoxelizer_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_PauseVoxelizer_Description}">
            <ui:ToggleSwitch IsChecked="{Binding PauseVoxelizer, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_LowerDetail_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_LowerDetail_Description}">
            <ui:ToggleSwitch IsChecked="{Binding LowerDetail, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_World}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FlatSky_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FlatSky_Description}">
            <ui:ToggleSwitch IsChecked="{Binding FlatSky, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_DisableGrass_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_DisableGrass_Description}">
            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_ReducedGrassMotion_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_ReducedGrassMotion_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ReducedGrassMotion, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_System}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_System_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_Gpu_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_Gpu_Description}">
            <ui:ToggleSwitch IsChecked="{Binding PreferHighPerformanceGpu, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_PowerPlan_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_PowerPlan_Description}">
            <ui:ToggleSwitch IsChecked="{Binding HighPerformancePowerPlan, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_Experimental}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_Experimental_Description}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_FramerateCap_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_FramerateCap_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding FramerateCaps, Mode=OneTime}" Text="{Binding SelectedFramerateCap, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Menu_Optimization_Categories_Maintenance}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_ClearCache_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_ClearCache_Description}">
            <ui:Button Icon="Delete24" Content="{x:Static resources:Strings.Menu_Optimization_ClearCache_Button}" Command="{Binding ClearCacheCommand}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Optimization_Folders_Title}"
            Description="{x:Static resources:Strings.Menu_Optimization_Folders_Description}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="Image24" Content="{x:Static resources:Strings.Menu_Optimization_Folders_Screenshots}" Command="{Binding OpenScreenshotsFolderCommand}" />
                <ui:Button Margin="8,0,0,0" Icon="DocumentText24" Content="{x:Static resources:Strings.Menu_Optimization_Folders_Logs}" Command="{Binding OpenRobloxLogsFolderCommand}" />
            </StackPanel>
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
